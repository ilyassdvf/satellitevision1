
@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap");
@import "tailwindcss";

:root {
  font-family: "DM Sans", sans-serif;
  color: #202b28;
  background: #f5f5f0;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  --ink: #17221f;
  --muted: #66716b;
  --green: #557b61;
  --line: #dfe3dc;
  --paper: #f5f5f0;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  margin: 0;
  min-width: 320px;
  background: var(--paper);
  color: var(--ink);
}

button,
a {
  font: inherit;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  cursor: pointer;
}

button:focus-visible,
a:focus-visible,
input:focus-visible {
  outline: 2px solid #70977a;
  outline-offset: 4px;
}

img {
  display: block;
  max-width: 100%;
}

.site-shell {
  overflow: hidden;
}

.section-wrap {
  width: min(1240px, calc(100% - 80px));
  margin-inline: auto;
}

.site-header {
  height: 82px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 max(40px, calc((100vw - 1240px) / 2));
  border-bottom: 1px solid rgba(32, 43, 40, 0.12);
  background: rgba(245, 245, 240, 0.94);
  position: sticky;
  top: 0;
  z-index: 20;
  backdrop-filter: blur(16px);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 11px;
  font: 700 15px Manrope, sans-serif;
  letter-spacing: -0.04em;
  white-space: nowrap;
}

.brand b {
  color: var(--green);
}

.brand-mark {
  width: 29px;
  height: 29px;
  border: 1px solid #8ba18e;
  border-radius: 50%;
  display: grid;
  place-items: center;
  position: relative;
}

.brand-mark:before {
  content: "";
  position: absolute;
  width: 35px;
  height: 13px;
  border: 1px solid #8ba18e;
  border-radius: 50%;
  transform: rotate(-34deg);
}

.brand-mark span {
  width: 6px;
  height: 6px;
  background: var(--green);
  border-radius: 50%;
}

.desktop-nav {
  display: flex;
  align-items: center;
  gap: 36px;
  margin-left: auto;
  margin-right: 38px;
}

.desktop-nav a,
.footer-links a {
  font-size: 12px;
  color: #5c6861;
  transition: color 0.2s;
}

.desktop-nav a:hover,
.footer-links a:hover {
  color: var(--green);
}

.nav-cta {
  font-size: 12px;
  font-weight: 700;
  border-bottom: 1px solid #809783;
  padding: 9px 0;
}

.nav-cta span {
  margin-left: 10px;
  color: var(--green);
}

.hero {
  min-height: 660px;
  display: grid;
  grid-template-columns: 0.83fr 1.17fr;
  align-items: center;
  gap: 70px;
  padding-top: 72px;
  padding-bottom: 95px;
}

.section-label {
  font-size: 10px;
  letter-spacing: 0.17em;
  font-weight: 700;
  color: var(--green);
  text-transform: uppercase;
  margin-bottom: 23px;
}

.hero h1,
.section-heading h2,
.classification-heading h2,
.technology-copy h2,
.results-intro h2,
.try-heading h2 {
  font: 500 clamp(48px, 5.3vw, 76px)/1.03 Manrope, sans-serif;
  letter-spacing: -0.075em;
  margin: 0;
}

.hero h1 em,
.technology-copy h2 em,
.try-heading h2 em {
  font-style: normal;
  color: var(--green);
}

.hero-copy > p {
  max-width: 410px;
  font-size: 15px;
  line-height: 1.85;
  color: var(--muted);
  margin: 24px 0 0;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 31px;
  flex-wrap: wrap;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 18px;
  min-height: 48px;
  padding: 0 19px;
  border: 1px solid var(--ink);
  font-size: 11px;
  font-weight: 700;
  transition: transform 0.2s, background 0.2s;
}

.button:hover {
  transform: translateY(-2px);
}

.button-dark {
  background: var(--ink);
  color: #f7f7f2;
}

.button-dark:hover {
  background: #34483d;
}

.button-light {
  background: transparent;
  color: var(--ink);
  border-color: #cbd1c9;
}

.button-light:hover {
  background: #e9ece5;
}

.hero-proof {
  display: flex;
  align-items: center;
  gap: 13px;
  flex-wrap: wrap;
  margin-top: 37px;
  color: #7b847d;
  font-size: 10px;
}

.hero-proof i {
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: #9ca79d;
}

.hero-image-wrap {
  height: 455px;
  position: relative;
  background: #263a35;
  overflow: hidden;
}

.hero-image-wrap > img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: saturate(0.72) brightness(0.78);
}

.image-shade {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(14, 29, 25, 0.15), transparent 55%),
    linear-gradient(0deg, rgba(8, 20, 16, 0.4), transparent 45%);
}

.image-coordinate {
  position: absolute;
  left: 24px;
  right: 24px;
  display: flex;
  justify-content: space-between;
  color: #e1e9df;
  font-size: 8px;
  letter-spacing: 0.15em;
}

.coord-top {
  top: 22px;
}

.coord-top span {
  color: #c7d5c7;
}

.coord-bottom {
  bottom: 21px;
}

.scan-frame {
  position: absolute;
  width: 45%;
  height: 49%;
  left: 31%;
  top: 24%;
  border: 1px solid rgba(225, 238, 220, 0.75);
}

.scan-frame:before,
.scan-frame:after {
  content: "";
  position: absolute;
  background: rgba(225, 238, 220, 0.55);
}

.scan-frame:before {
  width: 1px;
  height: 140%;
  left: 50%;
  top: -20%;
}

.scan-frame:after {
  height: 1px;
  width: 140%;
  left: -20%;
  top: 50%;
}

.scan-frame span {
  position: absolute;
  width: 9px;
  height: 9px;
  border-color: #dcebd8;
  border-style: solid;
}

.scan-frame span:nth-child(1) {
  left: -1px;
  top: -1px;
  border-width: 1px 0 0 1px;
}

.scan-frame span:nth-child(2) {
  right: -1px;
  top: -1px;
  border-width: 1px 1px 0 0;
}

.scan-frame span:nth-child(3) {
  left: -1px;
  bottom: -1px;
  border-width: 0 0 1px 1px;
}

.scan-frame span:nth-child(4) {
  right: -1px;
  bottom: -1px;
  border-width: 0 1px 1px 0;
}

.image-tag {
  position: absolute;
  right: 22px;
  bottom: 56px;
  color: #edf1e8;
  font-size: 8px;
  letter-spacing: 0.13em;
  display: flex;
  align-items: center;
  gap: 8px;
}

.image-tag i,
.api-status i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #8dbb8f;
  display: inline-block;
}

.intro-section {
  padding-top: 42px;
  padding-bottom: 32px;
  display: grid;
  grid-template-columns: 1fr 0.65fr;
  gap: 80px;
  align-items: end;
  border-top: 1px solid var(--line);
}

.section-heading h2,
.classification-heading h2,
.results-intro h2 {
  font-size: clamp(37px, 4vw, 54px);
}

.intro-text p {
  font-size: 14px;
  line-height: 1.85;
  color: var(--muted);
  max-width: 420px;
  margin: 0;
}

.small-rule {
  display: block;
  width: 54px;
  height: 1px;
  background: var(--green);
  margin-top: 24px;
}

.landscape-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  padding-bottom: 110px;
}

.landscape-card {
  height: 300px;
  position: relative;
  overflow: hidden;
  background: #304039;
}

.landscape-card.landscape-wide {
  height: 350px;
}

.landscape-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: saturate(0.72) brightness(0.76);
  transition: transform 0.6s;
}

.landscape-card:hover img {
  transform: scale(1.035);
}

.landscape-card:after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(0deg, rgba(10, 22, 17, 0.82), transparent 68%);
}

.landscape-card-content {
  position: absolute;
  z-index: 1;
  left: 28px;
  right: 28px;
  bottom: 26px;
  color: #fff;
}

.landscape-card-content > span {
  font-size: 8px;
  letter-spacing: 0.16em;
  color: #c4d4c4;
}

.landscape-card h3 {
  font: 600 25px Manrope;
  margin: 9px 0 5px;
  letter-spacing: -0.04em;
}

.landscape-card p {
  font-size: 11px;
  line-height: 1.6;
  color: #d1d9d0;
  max-width: 370px;
  margin: 0;
}

.classification-section {
  background: #e9ece5;
  padding: 100px 0 105px;
}

.classification-inner {
  display: grid;
  grid-template-columns: 0.75fr 1.25fr;
  gap: 85px;
  align-items: center;
}

.classification-heading p,
.technology-copy > p,
.results-intro > p,
.try-heading > p {
  font-size: 13px;
  line-height: 1.85;
  color: var(--muted);
  max-width: 390px;
  margin-top: 22px;
}

.class-visual-image {
  height: 360px;
  position: relative;
  overflow: hidden;
  background: #9aab94;
}

.class-visual-image > img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: saturate(0.65) brightness(0.8);
}

.class-overlay {
  position: absolute;
  inset: 0;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  grid-template-rows: repeat(4, 1fr);
  mix-blend-mode: multiply;
  opacity: 0.58;
}

.map-cell {
  border: 1px solid rgba(255, 255, 255, 0.23);
}

.cell-a {
  background: #3f7954;
  grid-area: 1/1/3/3;
}

.cell-b {
  background: #b5a65a;
  grid-area: 1/3/3/5;
}

.cell-c {
  background: #c58b45;
  grid-area: 3/1/5/3;
}

.cell-d {
  background: #a96c62;
  grid-area: 3/3/5/4;
}

.cell-e {
  background: #4b91b7;
  grid-area: 2/5/5/6;
}

.illustrative-note {
  position: absolute;
  bottom: 13px;
  left: 15px;
  color: #fff;
  font-size: 9px;
  letter-spacing: 0.04em;
  text-shadow: 0 1px 5px #000;
}

.class-legend {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  border: 1px solid #d3d9d0;
  border-top: 0;
}

.class-legend > div {
  padding: 15px 9px;
  display: flex;
  flex-direction: column;
  gap: 7px;
  border-right: 1px solid #d3d9d0;
}

.class-legend > div:last-child {
  border: 0;
}

.class-legend i {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}

.class-legend span {
  font-size: 8px;
  color: #8a948a;
}

.class-legend strong {
  font-size: 9px;
  line-height: 1.3;
  font-weight: 600;
}

.workflow-section {
  padding-top: 105px;
  padding-bottom: 110px;
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 70px;
}

.workflow-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.workflow-grid article {
  border-top: 1px solid #bfc9be;
  padding-top: 17px;
  position: relative;
}

.workflow-grid article > span,
.technology-points article > span {
  font-size: 9px;
  color: var(--green);
  letter-spacing: 0.12em;
}

.workflow-icon {
  font: 400 25px Manrope;
  color: var(--green);
  margin: 25px 0;
}

.workflow-grid h3 {
  font: 600 16px Manrope;
  margin: 0 0 10px;
}

.workflow-grid p {
  font-size: 11px;
  line-height: 1.75;
  color: var(--muted);
  margin: 0;
}

.technology-section {
  background: #1e3029;
  color: #f2f3ec;
  padding: 100px 0;
}

.technology-inner {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 110px;
}

.technology-copy .section-label {
  color: #a7c3a5;
}

.technology-copy h2 {
  font-size: clamp(42px, 4.7vw, 62px);
}

.technology-copy > p {
  color: #b4c0b5;
}

.technology-points {
  border-top: 1px solid rgba(226, 237, 224, 0.2);
}

.technology-points article {
  display: grid;
  grid-template-columns: 50px 1fr;
  gap: 20px;
  padding: 23px 0;
  border-bottom: 1px solid rgba(226, 237, 224, 0.2);
}

.technology-points article > span {
  color: #a7c3a5;
}

.technology-points h3 {
  font: 600 17px Manrope;
  margin: 0 0 7px;
}

.technology-points p {
  font-size: 11px;
  line-height: 1.7;
  color: #b4c0b5;
  margin: 0;
  max-width: 460px;
}

/* RESULTS AND RESEARCH DASHBOARD */

.results-section {
  padding-top: 110px;
  padding-bottom: 100px;
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 38px 80px;
}

.results-intro > p {
  max-width: 370px;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  align-self: center;
}

.metrics-grid article {
  border-left: 1px solid #cbd3c9;
  padding: 6px 0 6px 17px;
}

.metrics-grid article > span {
  font-size: 8px;
  letter-spacing: 0.13em;
  color: #78847a;
  font-weight: 700;
}

.metrics-grid strong {
  display: block;
  font: 500 clamp(27px, 3vw, 40px) Manrope;
  letter-spacing: -0.06em;
  margin: 17px 0 9px;
}

.metrics-grid strong small {
  font-size: 15px;
  color: var(--green);
}

.metrics-grid p {
  font-size: 10px;
  line-height: 1.55;
  color: var(--muted);
  margin: 0;
}

.experiment-block {
  grid-column: 1 / -1;
  border-top: 1px solid var(--line);
  padding-top: 35px;
  margin-top: 12px;
}

.research-heading {
  margin-bottom: 25px;
}

.research-heading .section-label {
  margin-bottom: 13px;
}

.research-heading h3 {
  font: 600 clamp(23px, 3vw, 32px)/1.2 Manrope, sans-serif;
  letter-spacing: -0.045em;
  margin: 0;
}

.research-heading > p {
  font-size: 12px;
  line-height: 1.8;
  color: var(--muted);
  max-width: 650px;
  margin: 10px 0 0;
}

.strategy-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.strategy-card {
  background: #f8f9f5;
  border: 1px solid #dce2d9;
  padding: 23px 20px;
}

.strategy-card h4 {
  font: 600 16px Manrope, sans-serif;
  margin: 0 0 24px;
}

.strategy-metric {
  margin-bottom: 20px;
}

.strategy-metric > div:first-child,
.cost-row-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
}

.strategy-metric span,
.cost-row p {
  color: var(--muted);
  font-size: 10px;
}

.strategy-metric strong {
  font: 600 11px Manrope, sans-serif;
  white-space: nowrap;
}

.research-bar {
  width: 100%;
  height: 7px;
  background: #e7ebe4;
  border-radius: 10px;
  overflow: hidden;
  margin-top: 9px;
}

.research-bar i {
  display: block;
  height: 100%;
  background: var(--green);
  border-radius: inherit;
}

.strategy-cost {
  display: grid;
  gap: 12px;
  border-top: 1px solid #e0e5dd;
  padding-top: 16px;
  margin-top: 18px;
}

.strategy-cost > div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.strategy-cost span {
  color: var(--muted);
  font-size: 9px;
}

.strategy-cost strong {
  font: 600 12px Manrope, sans-serif;
  overflow-wrap: anywhere;
}

.research-note {
  color: #7b867c;
  font-size: 10px;
  line-height: 1.75;
  margin: 17px 0 0;
}

.cost-comparison {
  background: #f8f9f5;
  border: 1px solid #dce2d9;
  padding: 24px;
  display: grid;
  gap: 24px;
}

.cost-row-heading strong {
  font: 600 12px Manrope, sans-serif;
}

.cost-row-heading span {
  font: 600 12px Manrope, sans-serif;
  color: var(--green);
}

.cost-row p {
  margin: 8px 0 0;
}

.cost-bar i {
  background: #819a7e;
}

.matrix-wrap,
.class-metrics-table-wrap {
  width: 100%;
  overflow-x: auto;
  border: 1px solid #dce2d9;
  background: #f8f9f5;
}

.confusion-table,
.class-metrics-table {
  width: 100%;
  border-collapse: collapse;
  text-align: center;
  font-size: 11px;
}

.confusion-table th,
.confusion-table td,
.class-metrics-table th,
.class-metrics-table td {
  padding: 15px 12px;
  border-bottom: 1px solid #e1e6df;
  border-right: 1px solid #e1e6df;
}

.confusion-table thead th,
.class-metrics-table thead th {
  background: #edf1e9;
  color: #526256;
  font-size: 9px;
  font-weight: 700;
}

.confusion-table tbody th,
.class-metrics-table tbody th {
  text-align: left;
  font-weight: 600;
  white-space: nowrap;
  background: #f2f4ef;
}

.confusion-table td {
  font: 600 13px Manrope, sans-serif;
  min-width: 65px;
}

.confusion-table .matrix-correct {
  background: #dce9d9;
  color: #315c3e;
}

.class-metrics-table td {
  font-variant-numeric: tabular-nums;
  color: #526256;
}

.model-card {
  grid-column: 1/-1;
  border: 1px solid #d7ddd4;
  padding: 26px 30px;
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 50px;
  background: #f8f8f4;
}

.model-card .section-label {
  margin-bottom: 13px;
}

.model-card h3 {
  font: 600 20px Manrope;
  margin: 0 0 7px;
}

.model-card > div > p {
  font-size: 10px;
  color: var(--muted);
  margin: 0;
}

.model-card dl {
  margin: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px 30px;
}

.model-card dl div {
  border-bottom: 1px solid #e2e6df;
  padding-bottom: 9px;
}

.model-card dt {
  font-size: 9px;
  color: #7a867c;
  margin-bottom: 5px;
}

.model-card dd {
  font-size: 11px;
  font-weight: 600;
  margin: 0;
}

.results-footnote {
  grid-column: 1/-1;
  font-size: 10px;
  line-height: 1.9;
  color: #78837b;
  margin: 0;
}

/* MODEL UPLOAD AND PREDICTIONS */

.try-section {
  background: #e7ebe3;
  padding: 100px 0;
}

.try-inner {
  display: grid;
  grid-template-columns: 0.7fr 1.3fr;
  gap: 85px;
  align-items: start;
}

.try-heading h2 {
  font-size: clamp(42px, 4.5vw, 60px);
}

.try-panel {
  background: #f8f9f5;
  border: 1px solid #d5ddd3;
  padding: 25px;
}

.try-panel-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 17px;
  border-bottom: 1px solid #e0e5dd;
  font-size: 8px;
  letter-spacing: 0.14em;
  font-weight: 700;
  color: #66746a;
}

.api-status {
  display: flex;
  align-items: center;
  gap: 7px;
  color: #68856b;
}

.upload-area {
  margin-top: 20px;
  min-height: 230px;
  border: 1px dashed #b9c7b8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 22px;
  transition: background 0.2s, border 0.2s;
}

.upload-area.dragging {
  background: #edf3eb;
  border-color: #648b6c;
}

.upload-symbol {
  width: 42px;
  height: 42px;
  border: 1px solid #cad6c8;
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: var(--green);
  font-size: 22px;
  margin-bottom: 13px;
}

.upload-area h3 {
  font: 600 16px Manrope;
  margin: 0;
}

.upload-area p {
  font-size: 11px;
  color: var(--muted);
  margin: 7px 0 15px;
}

.upload-area .button {
  min-height: 38px;
}

.upload-area > small {
  font-size: 9px;
  color: #89938a;
  margin-top: 12px;
}

.input-guidance {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  padding: 15px 0;
  border-bottom: 1px solid #e0e5dd;
}

.input-guidance span {
  font-size: 8px;
  color: #778278;
  letter-spacing: 0.1em;
}

.input-guidance strong {
  font-size: 10px;
}

.classify-button {
  width: 100%;
  margin-top: 16px;
}

.classify-button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
  transform: none;
}

.error-message {
  font-size: 11px;
  line-height: 1.6;
  color: #a33b32;
  background: #f8e9e6;
  padding: 11px;
  margin: 13px 0 0;
}

.prediction-result {
  margin-top: 20px;
  padding: 18px;
  border: 1px solid #dce3d9;
  background: #fff;
}

.prediction-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #e5e9e2;
  padding-bottom: 17px;
  margin-bottom: 16px;
}

.prediction-summary span,
.prediction-result h4 {
  font-size: 8px;
  letter-spacing: 0.12em;
  color: #758176;
  font-weight: 700;
}

.prediction-summary h3 {
  font: 600 22px Manrope;
  margin: 5px 0;
}

.prediction-summary p {
  font-size: 10px;
  color: var(--muted);
  margin: 0;
}

.prediction-summary > strong {
  font: 600 27px Manrope;
  color: var(--green);
}

.prediction-summary > strong small {
  font-size: 12px;
}

.prediction-result h4 {
  margin: 17px 0 12px;
}

.probability {
  margin: 11px 0;
}

.probability > div {
  display: flex;
  justify-content: space-between;
  font-size: 10px;
  margin-bottom: 6px;
}

.probability > div span {
  color: #58645b;
}

.probability > div b {
  font-weight: 600;
}

.probability > i {
  display: block;
  height: 6px;
  background: #edf0eb;
  border-radius: 8px;
  overflow: hidden;
}

.probability > i span {
  display: block;
  height: 100%;
  border-radius: 8px;
}

.batch-summary {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 7px;
}

.batch-summary span {
  display: flex;
  flex-direction: column;
  gap: 6px;
  background: #f1f4ee;
  padding: 9px;
  font-size: 8px;
  color: #68746a;
}

.batch-summary b {
  font: 600 16px Manrope;
  color: #24332a;
}

.upload-disclaimer {
  font-size: 9px;
  line-height: 1.65;
  color: #7b867c;
  margin: 15px 0 0;
}

/* FOOTER */

.site-footer {
  padding-top: 45px;
  padding-bottom: 42px;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 30px;
  align-items: start;
}

.site-footer > div:first-child > p {
  font-size: 10px;
  color: #7b867d;
  margin: 12px 0 0;
}

.footer-links {
  display: flex;
  gap: 23px;
  padding-top: 7px;
}

.footer-note {
  text-align: right;
  font-size: 9px;
  line-height: 1.8;
  color: #7b867d;
}

/* TABLET */

@media (max-width: 950px) {
  .section-wrap {
    width: min(100% - 48px, 760px);
  }

  .site-header {
    padding: 0 24px;
  }

  .hero {
    grid-template-columns: 1fr;
    gap: 38px;
    padding-top: 65px;
  }

  .hero-copy {
    max-width: 620px;
  }

  .hero-image-wrap {
    height: 390px;
  }

  .classification-inner,
  .workflow-section,
  .technology-inner,
  .results-section,
  .try-inner {
    grid-template-columns: 1fr;
    gap: 42px;
  }

  .classification-heading {
    max-width: 580px;
  }

  .technology-inner {
    gap: 40px;
  }

  .results-section {
    gap: 28px;
  }

  .experiment-block,
  .model-card,
  .results-footnote {
    grid-column: 1;
  }

  .metrics-grid {
    max-width: 700px;
  }

  .strategy-grid {
    grid-template-columns: 1fr 1fr;
  }

  .site-footer {
    grid-template-columns: 1fr 1fr;
  }

  .footer-note {
    grid-column: 1/-1;
    text-align: left;
  }
}

/* MOBILE */

@media (max-width: 640px) {
  .section-wrap {
    width: calc(100% - 36px);
  }

  .site-header {
    height: 68px;
    padding: 0 18px;
  }

  .desktop-nav {
    display: none;
  }

  .nav-cta {
    font-size: 10px;
  }

  .brand {
    font-size: 13px;
  }

  .hero {
    min-height: 0;
    padding-top: 55px;
    padding-bottom: 70px;
    gap: 35px;
  }

  .hero h1 {
    font-size: 51px;
  }

  .hero-copy > p {
    font-size: 13px;
  }

  .hero-actions {
    align-items: stretch;
    flex-direction: column;
  }

  .hero-image-wrap {
    height: 280px;
  }

  .intro-section {
    grid-template-columns: 1fr;
    gap: 20px;
    padding-top: 32px;
  }

  .section-heading h2,
  .classification-heading h2,
  .results-intro h2 {
    font-size: 40px;
  }

  .landscape-grid {
    grid-template-columns: 1fr;
    padding-bottom: 70px;
  }

  .landscape-card,
  .landscape-card.landscape-wide {
    height: 280px;
  }

  .classification-section,
  .technology-section,
  .try-section {
    padding: 70px 0;
  }

  .class-visual-image {
    height: 250px;
  }

  .class-legend {
    grid-template-columns: repeat(2, 1fr);
  }

  .class-legend > div {
    border-bottom: 1px solid #d3d9d0;
  }

  .class-legend > div:nth-child(2n) {
    border-right: 0;
  }

  .class-legend > div:last-child {
    grid-column: 1/-1;
  }

  .workflow-section {
    padding-top: 70px;
    padding-bottom: 75px;
  }

  .workflow-grid {
    grid-template-columns: 1fr;
    gap: 22px;
  }

  .workflow-grid article {
    padding: 15px 0;
  }

  .workflow-icon {
    margin: 13px 0;
  }

  .technology-points article {
    grid-template-columns: 35px 1fr;
  }

  .results-section {
    padding-top: 75px;
    padding-bottom: 70px;
  }

  .metrics-grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .metrics-grid article {
    padding: 5px 0 5px 15px;
  }

  .metrics-grid strong {
    margin: 8px 0;
  }

  .experiment-block {
    padding-top: 27px;
  }

  .strategy-grid {
    grid-template-columns: 1fr;
  }

  .strategy-card {
    padding: 20px;
  }

  .cost-comparison {
    padding: 17px;
  }

  .confusion-table,
  .class-metrics-table {
    min-width: 600px;
  }

  .research-heading h3 {
    font-size: 24px;
  }

  .model-card {
    grid-template-columns: 1fr;
    padding: 20px;
    gap: 22px;
  }

  .model-card dl {
    grid-template-columns: 1fr;
  }

  .try-panel {
    padding: 16px;
  }

  .input-guidance {
    align-items: flex-start;
    flex-direction: column;
  }

  .batch-summary {
    grid-template-columns: repeat(2, 1fr);
  }

  .site-footer {
    grid-template-columns: 1fr;
    gap: 23px;
  }

  .footer-links {
    flex-wrap: wrap;
  }

  .footer-note {
    grid-column: auto;
    text-align: left;
  }
}
