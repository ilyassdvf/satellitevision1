import { ChangeEvent, DragEvent, ReactNode, useEffect, useRef, useState } from "react";

type Page = "home" | "classify" | "model" | "research";
type IconName =
  | "arrow"
  | "brain"
  | "chart"
  | "check"
  | "chevron"
  | "database"
  | "download"
  | "file"
  | "globe"
  | "grid"
  | "home"
  | "image"
  | "layers"
  | "menu"
  | "model"
  | "pulse"
  | "satellite"
  | "spark"
  | "upload"
  | "x";

const IMAGES = {
  hero: "https://images.unsplash.com/photo-1496288117861-edcd4f91bc05?crop=entropy&cs=tinysrgb&fit=crop&fm=jpg&q=88&w=1600",
  forest:
    "https://images.unsplash.com/photo-1675371788315-60fa0ef48267?crop=entropy&cs=tinysrgb&fit=crop&fm=jpg&q=82&w=700",
  residential:
    "https://images.unsplash.com/photo-1508179907815-7be58e0fbebc?crop=entropy&cs=tinysrgb&fit=crop&fm=jpg&q=82&w=700",
  water:
    "https://images.unsplash.com/photo-1543348750-466b55f32f16?crop=entropy&cs=tinysrgb&fit=crop&fm=jpg&q=82&w=700",
};

function Icon({ name, size = 20 }: { name: IconName; size?: number }) {
  const paths: Record<IconName, ReactNode> = {
    arrow: (
      <>
        <path d="M5 12h14" />
        <path d="m13 6 6 6-6 6" />
      </>
    ),
    brain: (
      <>
        <path d="M9.5 4.5a3 3 0 0 0-5 2.2 3.5 3.5 0 0 0-.5 6.7 3 3 0 0 0 5.5 2.1V4.5Z" />
        <path d="M14.5 4.5a3 3 0 0 1 5 2.2 3.5 3.5 0 0 1 .5 6.7 3 3 0 0 1-5.5 2.1V4.5Z" />
        <path d="M9.5 9H7m7.5 3H17" />
      </>
    ),
    chart: (
      <>
        <path d="M4 19V9m6 10V5m6 14v-7m4 7H2" />
      </>
    ),
    check: <path d="m5 12 4 4L19 6" />,
    chevron: <path d="m9 18 6-6-6-6" />,
    database: (
      <>
        <ellipse cx="12" cy="5" rx="8" ry="3" />
        <path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6" />
      </>
    ),
    download: (
      <>
        <path d="M12 4v11m0 0 4-4m-4 4-4-4" />
        <path d="M5 19h14" />
      </>
    ),
    file: (
      <>
        <path d="M6 3h8l4 4v14H6z" />
        <path d="M14 3v5h5M9 13h6m-6 4h4" />
      </>
    ),
    globe: (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18M12 3c2.5 2.5 3.5 5.5 3.5 9S14.5 18.5 12 21c-2.5-2.5-3.5-5.5-3.5-9S9.5 5.5 12 3Z" />
      </>
    ),
    grid: (
      <>
        <rect x="4" y="4" width="6" height="6" rx="1" />
        <rect x="14" y="4" width="6" height="6" rx="1" />
        <rect x="4" y="14" width="6" height="6" rx="1" />
        <rect x="14" y="14" width="6" height="6" rx="1" />
      </>
    ),
    home: (
      <>
        <path d="m3 11 9-8 9 8" />
        <path d="M5 10v10h14V10M9 20v-6h6v6" />
      </>
    ),
    image: (
      <>
        <rect x="3" y="4" width="18" height="16" rx="2" />
        <circle cx="8" cy="9" r="2" />
        <path d="m3 17 5-5 4 4 3-3 6 6" />
      </>
    ),
    layers: (
      <>
        <path d="m12 3 9 5-9 5-9-5 9-5Z" />
        <path d="m3 12 9 5 9-5m-18 4 9 5 9-5" />
      </>
    ),
    menu: <path d="M4 7h16M4 12h16M4 17h16" />,
    model: (
      <>
        <rect x="4" y="4" width="6" height="6" rx="1" />
        <rect x="14" y="14" width="6" height="6" rx="1" />
        <path d="M10 7h4a3 3 0 0 1 3 3v4M7 10v7h7" />
      </>
    ),
    pulse: <path d="M3 12h4l2.2-5 4.1 10 2.2-5H21" />,
    satellite: (
      <>
        <path d="m9 9 6 6m-7 1-3 3m11-11 3-3M6 8l-3-3 2-2 3 3m10 10 3 3-2 2-3-3" />
        <rect x="8" y="8" width="8" height="8" rx="2" transform="rotate(-45 12 12)" />
      </>
    ),
    spark: (
      <path d="m12 3 1.7 5.3L19 10l-5.3 1.7L12 17l-1.7-5.3L5 10l5.3-1.7L12 3Zm6 13 .8 2.2L21 19l-2.2.8L18 22l-.8-2.2L15 19l2.2-.8L18 16Z" />
    ),
    upload: (
      <>
        <path d="M12 16V4m0 0L7 9m5-5 5 5" />
        <path d="M5 15v4h14v-4" />
      </>
    ),
    x: <path d="M6 6l12 12M18 6 6 18" />,
  };
  return (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      strokeWidth="1.8"
      strokeLinecap="round"
      strokeLinejoin="round"
      aria-hidden="true"
    >
      {paths[name]}
    </svg>
  );
}

const navItems: { id: Page; label: string; icon: IconName }[] = [
  { id: "home", label: "Home", icon: "home" },
  { id: "classify", label: "Image Classification", icon: "image" },
  { id: "model", label: "About the Model", icon: "model" },
  { id: "research", label: "Research Results", icon: "chart" },
];

// Local development uses the FastAPI server on port 8000.
// For an online deployment, set VITE_API_BASE_URL to your deployed backend URL.
const configuredApiUrl = (
  import.meta as ImportMeta & { env?: { VITE_API_BASE_URL?: string } }
).env?.VITE_API_BASE_URL;

const API_BASE_URL = (
  configuredApiUrl?.trim() ||
  (window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1"
    ? "http://127.0.0.1:8000"
    : window.location.origin)
).replace(/\/+$/, "");

function Brand() {
  return (
    <div className="brand">
      <span className="brand-orbit">
        <Icon name="satellite" size={17} />
      </span>
      <span>
        SatelliteVision <b>AI</b>
        <small>Research System</small>
      </span>
    </div>
  );
}

function PageTitle({
  eyebrow,
  title,
  description,
  action,
}: {
  eyebrow: string;
  title: string;
  description: string;
  action?: ReactNode;
}) {
  return (
    <header className="page-title">
      <div>
        <span>{eyebrow}</span>
        <h1>{title}</h1>
        <p>{description}</p>
      </div>
      {action}
    </header>
  );
}

